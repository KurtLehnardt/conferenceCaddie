{
  "route": "push.native.put",
  "examples": [
    {
      "name": "register the iOS app (APNs, production)",
      "request": {
        "headers": {
          "X-Caddie-Device": "AAECAwQFBgcICQoLDA0ODw.ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8"
        },
        "body": {
          "event": "kubecon-cloudnativecon-north-america-2026",
          "platform": "apns",
          "token": "00fa4e5c0ffee0000000000000000000000000000000000000000000000000ff"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      }
    },
    {
      "name": "register a development build of the iOS app (APNs sandbox)",
      "request": {
        "headers": {
          "X-Caddie-Device": "AAECAwQFBgcICQoLDA0ODw.ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8"
        },
        "body": {
          "event": "kubecon-cloudnativecon-north-america-2026",
          "platform": "apns",
          "token": "00fa4e5c0ffee0000000000000000000000000000000000000000000000000ee",
          "environment": "sandbox"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      }
    },
    {
      "name": "register the Android app (FCM)",
      "request": {
        "headers": {
          "X-Caddie-Device": "AAECAwQFBgcICQoLDA0ODw.ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8"
        },
        "body": {
          "event": "kubecon-cloudnativecon-north-america-2026",
