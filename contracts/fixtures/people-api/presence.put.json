    },
    {
      "name": "keep: no live presence is refused and starts none",
      "requires": "people.presence_keep_until",
      "request": {
        "headers": {
          "X-Caddie-Device": "AAECAwQFBgcICQoLDA0ODw.ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8"
        },
        "body": {
          "event": "kubecon-cloudnativecon-north-america-2026",
          "zone": "Hallway",
          "until": "keep",
          "ble": false
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": "presence_not_active",
          "message": "until: 'keep' needs presence that is on; turn it on with 'hour' or 'day'."
        }
      }
    }
  ]
