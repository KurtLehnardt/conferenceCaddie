        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "zone": "Hallway",
          "spot": null,
          "spot_hidden": false,
          "until": "keep",
          "presence_since": "2026-11-10T17:00:00.000Z",
          "presence_until": "2026-11-10T18:00:00.000Z",
          "located": true,
          "ble_key": "oKGio6SlpqeoqaqrrK2ur7CxsrO0tba3uLm6u7y9vr8",
