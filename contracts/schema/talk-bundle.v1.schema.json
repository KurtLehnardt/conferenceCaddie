{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KurtLehnardt/conferenceCaddie/main/contracts/schema/talk-bundle.v1.schema.json",
  "title": "Talk bundle bundle.json, v1",
  "description": "One conference's talks, topics, facet names, attribution, vector layout and related talks. The vectors themselves are in the sibling file vectors.i8. Rules a schema cannot state (sort orders, cross-references, hashes, the related lists matching the vectors) are checked by verifyBundle in contracts/js/bundle.mjs and listed in docs/contracts/talk-bundle.md.",
  "type": "object",
  "required": ["bundle_version", "conference", "attribution", "model", "vectors", "talks", "topics", "facets", "related"],
  "properties": {
    "bundle_version": { "const": 1 },
    "conference": { "$ref": "conferences-index.v1.schema.json#/$defs/Conference" },
    "attribution": {
      "description": "What the licence of the schedule content needs to travel with it: the licensor, the licence, the source, the changes made and the publisher's takedown contact.",
      "type": "object",
      "required": ["licensor", "license", "license_url", "source_url", "changes", "takedown"],
      "properties": {
        "licensor": { "type": "string", "minLength": 1 },
        "license": { "description": "For Linux Foundation schedules: CC BY 3.0.", "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "source_url": { "description": "The conference's official_schedule_url.", "type": ["string", "null"] },
        "changes": { "type": "string", "minLength": 1 },
        "takedown": { "description": "Where to ask for content to be removed: an https URL or a mailto: address.", "type": "string", "pattern": "^(https://|mailto:)" }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "onnx", "dims", "pooling", "normalized", "max_tokens", "query_prefix", "passage"],
      "properties": {
        "id": { "const": "BAAI/bge-small-en-v1.5" },
        "onnx": { "description": "The ONNX export the apps and the bundle builder run.", "const": "Xenova/bge-small-en-v1.5" },
        "dims": { "const": 384 },
        "pooling": { "const": "cls" },
        "normalized": { "const": true },
        "max_tokens": { "const": 512 },
        "query_prefix": { "description": "Prepended to a search query (not to talk text) before embedding.", "const": "Represent this sentence for searching relevant passages: " },
        "passage": { "description": "How a talk's text is built before embedding.", "const": "title + \"\\n\" + abstract" }
      }
    },
    "vectors": {
      "type": "object",
      "required": ["file", "dtype", "dims", "count", "quantization", "rows"],
      "properties": {
        "file": { "const": "vectors.i8" },
        "dtype": { "const": "int8" },
        "dims": { "const": 384 },
        "count": { "type": "integer", "minimum": 0 },
        "quantization": { "const": "int8-symmetric-row-maxabs" },
        "rows": { "description": "talk_id of each row of vectors.i8, in file order: every talk and ambient item, in talks order.", "type": "array", "items": { "$ref": "#/$defs/TalkId" }, "uniqueItems": true }
      }
    },
    "talks": { "type": "array", "items": { "$ref": "#/$defs/Talk" } },
    "topics": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "type": "object",
        "required": ["topic_id", "label", "talk_count", "rank", "aliases"],
        "properties": {
          "topic_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
          "label": { "type": "string", "minLength": 1 },
          "talk_count": { "type": "integer", "minimum": 0 },
          "rank": { "type": "integer", "minimum": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facets": {
      "description": "The value-matching names: the documents scripts/build-facets.mjs writes to caddie-facets, computed from the kind talk items.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "value", "label", "group", "keys", "words", "talks"],
        "properties": {
          "kind": { "enum": ["track", "room", "speaker", "tag"] },
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "group": { "description": "The tag group for kind tag, else null.", "type": ["string", "null"] },
          "keys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "words": { "type": "string" },
          "talks": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "related": {
      "description": "For every talk with a vector: up to five other talks, most similar first.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/TalkId" },
      "additionalProperties": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/TalkId" } }
    }
  },
  "$defs": {
    "TalkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}:[A-Za-z0-9_-]{1,64}$" },
    "NullableString": { "type": ["string", "null"] },
    "Talk": {
      "description": "One schedule item, as in data/{slug}/talks.ndjson without session_id, conference, tag_keys, content_hash, ingested_at and speaker_profiles (public bundles carry no speaker bios, photos or links), and with topics.",
      "type": "object",
      "required": ["talk_id", "kind", "title", "abstract", "speakers", "speaker_taglines", "room", "track", "level", "tags", "sponsor", "has_slides", "slides_url", "url", "start", "end", "day", "start_minutes", "end_minutes", "topics", "text_hash"],
      "properties": {
        "talk_id": { "$ref": "#/$defs/TalkId" },
        "kind": { "enum": ["talk", "ambient", "break", "housekeeping"] },
        "title": { "type": "string" },
        "abstract": { "type": "string" },
        "speakers": { "type": "array", "items": { "type": "string" } },
        "speaker_taglines": { "description": "Each speaker's one-line tagline from the feed, normally their title and organisation; null when they gave none.", "type": "array", "items": { "$ref": "#/$defs/NullableString" } },
        "room": { "$ref": "#/$defs/NullableString" },
        "track": { "$ref": "#/$defs/NullableString" },
        "level": { "$ref": "#/$defs/NullableString" },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "value"],
            "properties": { "group": { "type": "string" }, "value": { "type": "string" } }
          }
        },
        "sponsor": { "type": "boolean" },
        "has_slides": { "type": "boolean" },
        "slides_url": { "$ref": "#/$defs/NullableString" },
        "url": { "$ref": "#/$defs/NullableString" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "day": { "type": "string", "format": "date" },
        "start_minutes": { "type": "integer", "minimum": 0, "maximum": 2880 },
        "end_minutes": { "type": "integer", "minimum": 0, "maximum": 2880 },
        "topics": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" } },
        "text_hash": { "description": "sha256 of title + \"\\n\" + abstract, UTF-8, hex.", "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
