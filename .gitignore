# Secrets and credentials. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.jks
*.keystore
*credentials*.json
*service-account*.json
*sa-key*.json
gcp-key*.json
application_default_credentials.json
.secrets/

# Dependencies and build output
node_modules/
dist/
dist-worker/

# Local tooling
.claude/worktrees/
.claude/settings.local.json
.DS_Store
*.log

# Local exports of people data. Never commit these.
data/exports/

# Output of scripts/build-bundles.mjs and the embedding model cache
dist-pages/
.cache/

# Python bytecode caches (native/scripts and elsewhere)
__pycache__/

# The demo conference's files, generated by scripts/ingest.mjs from config/demo-conference.json on
# every run (pages.yml generates them for each build). Commit data/conference-operator.json, not these.
data/caddie-demo-conference/
