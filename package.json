{
  "name": "conference-caddie",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first web app that helps attendees of Linux Foundation conferences find people to talk to and talks they would like, with Elasticsearch hybrid search",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "es:setup": "node scripts/es-setup.mjs",
    "ingest": "node scripts/ingest.mjs",
    "zones": "node scripts/build-windows-zones.mjs",
    "topics": "node scripts/topics.mjs",
    "people:setup": "node scripts/es-setup-people.mjs",
    "people:seed": "node scripts/seed-people.mjs",
    "people:export": "node scripts/export-people.mjs",
    "people:purge": "node scripts/purge-expired-people.mjs",
    "people:backfill-ref": "node scripts/backfill-ref.mjs",
    "reports:setup": "node scripts/es-setup-reports.mjs",
    "push:setup": "node scripts/es-setup-push.mjs",
    "push:vapid-keys": "node scripts/vapid-keys.mjs",
    "moderation": "node scripts/moderation.mjs",
    "rules:setup": "node scripts/es-setup-rules.mjs",
    "rules:reload": "node scripts/moderation-rules.mjs --reload-rules",
    "start": "node server/index.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "bundles": "node scripts/build-bundles.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"test/*.test.mjs\" \"worker/test/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "web-push": "4.0.0"
  }
}
