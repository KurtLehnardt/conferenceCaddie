<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth, notification and foreground-service permissions arrive with the BleRadio
         implementation; the skeleton only talks to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ONNX Runtime's AAR adds a telemetry uploader to Microsoft (a content provider that starts
         with the app) and the network-state permission it uses. The app sends nothing but to its
         backend, so both are removed here (the checkOnnxRuntimeManifest task fails the build if either
         comes back), and CaddieApplication sets ORT_DISABLE_TELEMETRY before ONNX Runtime starts
         (DECISIONS.md, phase 2b). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- No backups and no device-to-device transfer: the app will hold per-backend device secrets
         that must not leave the phone. allowBackup="false" covers Android 11 and older;
         dataExtractionRules covers Android 12 and newer, where allowBackup alone does not stop a
         device-to-device transfer. Cleartext traffic is off; debug builds add an exception for a
         server on the developer's machine (src/debug). -->
    <application
        android:name=".CaddieApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caddie">
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
        <!-- singleTask: a caddie:// link or a schedule file opened while the app runs reaches the
             running screen (onNewIntent) instead of starting a second one in another app's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- caddie://connect?url=... (an operator's server link or QR code, which the app only
                 ever offers to switch to after the person confirms) and caddie://e/<slug>#/<tab>,
                 the web's routes. No https App Links: see DECISIONS.md, phase 2c. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="caddie" android:host="connect" />
                <data android:scheme="caddie" android:host="e" />
            </intent-filter>
            <!-- "Open with" and "Share" for calendar and spreadsheet exports: the file opens Import
                 my schedule. Only content: addresses are read (MainActivity.handOff). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
        </activity>
    </application>

</manifest>
