<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The people features: the device's position for presence ("Use my position too"), only
         while the app is in use, so there is no background location and no foreground service for it.
         Android 12 and newer need both location permissions in the same request; the person then
         picks precise or approximate. POST_NOTIFICATIONS shows nudges on Android 13 and newer.
         The background nudge check is a periodic JobScheduler job, which needs no permission of its
         own. It is deliberately not persisted across a reboot: that would need
         RECEIVE_BOOT_COMPLETED, and the app keeps its permissions minimal. The job is scheduled again
         the next time the app starts. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app works without location hardware; the position switch is then hidden. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Bluetooth proximity (docs/contracts/ble-tokens.md): the phone advertises a token derived
         from its session key, serves it to phones that connect, and scans for the tokens of others.
         Android 12 and newer (API 31) ask for these three together as "Nearby devices". The scan is
         declared as never used for location, which is true: no position is derived from a scan
         result, and only tokens and their signal strength are passed on. Before Android 12 the
         install-time BLUETOOTH and BLUETOOTH_ADMIN permissions cover all three, and a scan needs
         ACCESS_FINE_LOCATION (declared above for presence) although no position is read. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- While Bluetooth proximity is on, a foreground service of type connectedDevice keeps it
         running with the app in the background or the screen off, with an ongoing notification
         that has a Stop action. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- When the Bluetooth runtime's next report is due, an alarm wakes the phone and a partial wake
         lock of at most 15 seconds keeps it awake while the report goes out. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Before Android 13, the Bluetooth service's receiver of the app's own alarms and notification
         dismissals is registered behind this signature permission, so no other app can send to it
         (what ContextCompat.registerReceiver does with RECEIVER_NOT_EXPORTED; AndroidX Core declares
         the same permission, and the two declarations merge). -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <!-- The app works without Bluetooth LE; Bluetooth proximity is then hidden. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- ONNX Runtime's AAR adds a telemetry uploader to Microsoft (a content provider that starts
         with the app) and the network-state permission it uses. The app sends nothing but to its
         backend, so both are removed here (the checkOnnxRuntimeManifest task fails the build if either
         comes back), and CaddieApplication sets ORT_DISABLE_TELEMETRY before ONNX Runtime starts
         (DECISIONS.md, phase 2b). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- No backups and no device-to-device transfer: the app will hold per-backend device secrets
         that must not leave the phone. allowBackup="false" covers Android 11 and older;
         dataExtractionRules covers Android 12 and newer, where allowBackup alone does not stop a
         device-to-device transfer. Cleartext traffic is off; debug builds add an exception for a
         server on the developer's machine (src/debug). -->
    <application
        android:name=".CaddieApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caddie">
        <!-- The only WebView the app makes is CapacitorMigration's, which reads the old app's
             storage once and fetches nothing; it sends no usage metrics either. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
        <!-- singleTask: a caddie:// link or a schedule file opened while the app runs reaches the
             running screen (onNewIntent) instead of starting a second one in another app's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- caddie://connect?url=... (an operator's server link or QR code, which the app only
                 ever offers to switch to after the person confirms) and caddie://e/<slug>#/<tab>,
                 the web's routes, the people screens' among them (#/inbox, #/meet/<id>). No https
                 App Links: see DECISIONS.md, phase 2c. The links of the app's own notifications
                 (caddie://inbox and the like) are not listed: a tap brings its link as an extra
                 with the install's tap key (AndroidNotifier). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="caddie" android:host="connect" />
                <data android:scheme="caddie" android:host="e" />
            </intent-filter>
            <!-- "Open with" and "Share" for calendar and spreadsheet exports: the file opens Import
                 my schedule and waits for a tap. Only content: addresses are read, at most 5 MB
                 (IncomingIntents). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
        </activity>
        <!-- Bluetooth proximity's radio (shared/.../ble/BleRadioService.kt). Swiping the app from
             Recents does not stop it; the system may restart it after ending the process, and
             CaddieApplication then recreates the people features that restore its session. -->
        <service
            android:name="app.conferencecaddie.shared.ble.BleRadioService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".BackgroundNudgeJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
