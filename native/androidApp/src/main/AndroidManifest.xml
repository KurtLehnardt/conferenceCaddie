<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth and foreground-service permissions arrive with the BleRadio implementation. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The people features: the device's position for presence ("Use my position too"), only
         while the app is in use, so there is no background location and no foreground service.
         Android 12 and newer need both location permissions in the same request; the person then
         picks precise or approximate. POST_NOTIFICATIONS shows nudges on Android 13 and newer. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app works without location hardware; the position switch is then hidden. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- No backups and no device-to-device transfer: the app will hold per-backend device secrets
         that must not leave the phone. allowBackup="false" covers Android 11 and older;
         dataExtractionRules covers Android 12 and newer, where allowBackup alone does not stop a
         device-to-device transfer. Cleartext traffic is off; debug builds add an exception for a
         server on the developer's machine (src/debug). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caddie">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
