<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The test APK merges ONNX Runtime's AAR too. Its telemetry uploader and the network-state
         permission are removed here as in the app (androidApp/src/main/AndroidManifest.xml), so the
         tests on an emulator send nothing to Microsoft either. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application>
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>

</manifest>
