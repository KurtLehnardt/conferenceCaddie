<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's privacy manifest. The required-reason APIs below were found with `nm -u` on the
     Release iosArm64 ComposeApp framework (Kotlin 2.4.21, Compose Multiplatform 1.12.2):
     stat and fstat (Skia's file access and ICU's data file), and mach_absolute_time (Skia's DNG
     codec timing). Phase 2a adds lstat (FileTimestamp, the bundle cache's file system calls), and
     statfs and fstatfs (DiskSpace), which the bundled SQLite calls on the file system that holds
     its database while it writes the database's files. E174.1 is the DiskSpace reason for checking
     disk space in order to write files; it is the one declared because these calls serve only
     SQLite's own writes, and the app never shows the result or sends it off the device.
     Phase 2b links ONNX Runtime 1.30.0 statically, which adds no other required-reason API; its
     telemetry, which would send usage data to Microsoft, is switched off (ORT_DISABLE_TELEMETRY, see
     DECISIONS.md). No user-defaults API is linked. Check again with
     `nm -u ComposeApp.framework/ComposeApp` whenever dependencies change, and fill in
     NSPrivacyCollectedDataTypes when the app starts sending profile data to a backend. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
